{
  "name": "@cocreate/dynamodb",
  "version": "1.6.0",
  "description": "Lightweight, real-time Amazon DynamoDB CRUD wrapper and multi-tenant state routing client for the collaborative CoCreate ecosystem.",
  "keywords": [
    "dynamodb",
    "aws-dynamodb",
    "nosql",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization",
    "shared-editing",
    "collaborative-editing",
    "websocket-mesh",
    "peer-to-peer-sync",
    "p2p-database"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-dynamodb.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-dynamodb/issues"
  },
  "homepage": "https://cocreate.app/docs/dynamodb",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/dynamodb.js",
    "./installer": "./installer/dynamodb.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@cocreate/utils": "^1.54.0"
  }
}
